{
  "name": "hiiscript",
  "version": "1.0.0",
  "productName": "Hiiscript",
  "description": "An open source screenplay writer.",
  "author": {
    "name": "Hiiscript",
    "email": "maintainers@hiiscript.invalid"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-devtools",
    "web": "npx http-server www -p 8080",
    "test": "node --test test/*.test.js",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:win": "electron-builder --win nsis portable",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "keywords": [
    "screenplay",
    "writing",
    "electron",
    "capacitor"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^25.1.8",
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "build": {
    "appId": "com.hiiscript.app",
    "productName": "Hiiscript",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "images/**/*",
      "capacitor.config.json",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "images/icons",
      "category": "Office",
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "images/hiiscript.ico"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.${ext}"
    }
  }
}
